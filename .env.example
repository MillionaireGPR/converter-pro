# ============================================
# Variaveis de ambiente - Converter Pro
# Copie este arquivo para .env.local e preencha
# ============================================

# --- Frontend (Vite/Vercel) ---
# Onde roda cada parte: CLAUDE.md secao 0.
# Local: aponte o primario para o backend local.
# Producao (Vercel): PRIMARY = Integrator, FALLBACK = Render (suspenso), FALLBACK_2 = Wesley (fora).
VITE_BACKEND_URL_PRIMARY=http://localhost:8000
VITE_BACKEND_URL_FALLBACK=
VITE_BACKEND_URL_FALLBACK_2=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Backend (Python) ---
# Producao: /opt/converter-pro/config/backend.env no Integrator (modelo: infra/integrator/backend.env.example)
SUPABASE_URL=https://<seu-projeto>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...
