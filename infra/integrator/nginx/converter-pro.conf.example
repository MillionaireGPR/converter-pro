# Modelo final para o dominio publico do backend.
server {
    listen 80;
    server_name conversor-vps.metodoiqc.com.br;

    location ^~ /.well-known/acme-challenge/ {
        root /usr/share/nginx/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name conversor-vps.metodoiqc.com.br;

    ssl_certificate /www/sites/conversor-vps.metodoiqc.com.br/ssl/fullchain.pem;
    ssl_certificate_key /www/sites/conversor-vps.metodoiqc.com.br/ssl/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 300m;
    client_body_timeout 300s;

    location / {
        proxy_pass http://127.0.0.1:28081;
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_connect_timeout 15s;
        proxy_send_timeout 1800s;
        proxy_read_timeout 1800s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
